# ─────────────────────────────────────────────────────────────────────────────
# Rename this file to .env and fill in your actual keys.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# Gemini API key (free tier works for Q11-Q14 insights generation)
# Get yours at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_NAME=gemini-2.0-flash,gemini-2.0-flash-lite,gemini-2.5-flash-lite
GEMINI_MIN_REQUEST_GAP_SEC=13
GEMINI_MAX_EVIDENCE_CHARS="4500"
GEMINI_OVERLOAD_RETRY_LIMIT="2"
GEMINI_PARSE_RETRY_LIMIT="4"